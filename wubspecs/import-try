#!/usr/bin/env bash

set -x # Show commands
set -eu # Errors/undefined vars are fatal
set -o pipefail # Check all commands in a pipeline

# Import a spec repository's pull request into wubspecs' token-centric
# history, for reviewing it at /wubspecs/try/SPEC/NUMBER, for the web server
# (see mozsearch's tools/src/try_import.rs, which runs this with SPEC/NUMBER,
# SPEC being the spec repository's directory in the forest): fetch it from
# GitHub (`refs/pull/NUMBER/head`, through git rather than its API), make the
# forest commits of its commits and of its head rebased onto the forest's tip
# (mozsearch's build-spec-pr; see tools/src/spec_forest.rs), process them
# with mozsearch's scripts/import-try-push.sh, as the history is built (see
# update-history.sh, whose 4 compute threads are for the HTML Standard's big
# files' tokens), and render and analyze it.

NAME=$1
OUT=$(mktemp)
step() {
    echo "Performing import::$1 step for $NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"
}
# (Fetched from GitHub first, beside the other imports, which don't wait for
# it; see mozsearch's tools/src/spec_forest.rs's `fetch_pull_request`.)
step fetch
if ! build-spec-pr --fetch-only "$CONFIG_REPO/$TREE_NAME/specs.toml" "$GIT_ROOT" "$NAME" > "$OUT"; then
    cat "$OUT"
    exit 1
fi
cat "$OUT"
# (Its forest commits take turns with the other imports' forest commits, by
# a lock of their own rather than the history's, TRY_IMPORT_LOCK (see
# mozsearch's tools/src/try_import.rs), so that while a batch of imports
# processes its history the others make theirs and wait for the next batch:
# they only write new objects and the pull request's own refs, which the
# history steps don't, and read refs which only the forest's update at
# indexing changes; see mozsearch's tools/src/spec_forest.rs's
# `pull_request_commits`.  The steps say when it got the lock.)
step wait-for-forest
exec 9>"$HISTORY_ROOT/try-imports/forest.lock"
flock 9
step forest-commits
if ! build-spec-pr "$CONFIG_REPO/$TREE_NAME/specs.toml" "$GIT_ROOT" "$NAME" > "$OUT"; then
    cat "$OUT"
    exit 1
fi
flock -u 9
exec 9>&-
cat "$OUT"
STACK=$(sed -n 's/^stack: //p' "$OUT")
HEAD_REV=$(sed -n 's/^head: //p' "$OUT")

# Its history, with the other imports waiting to import theirs, in one
# history run (see mozsearch's scripts/import-try-push-batched.sh, which
# takes the history's lock).
step history
SYNTAX_COMPUTE_THREADS=4 PUSH_REVS="$STACK" "$MOZSEARCH_PATH/scripts/import-try-push-batched.sh" \
    "$GIT_ROOT" "$HISTORY_ROOT" "$GIT_BRANCH" "$NAME" "$HEAD_REV" "$MAX_REVISIONS"
step unlocked

# Its head's renderings of the Bikeshed specs it changes, and its semantic
# analysis (see mozsearch's scripts/analyze-spec-pr.sh), with Bikeshed and
# spec-analyze in a bubblewrap sandbox (installed for firefox-try's semantic
# analysis, on the same web server; see
# ../firefox-shared/semantic/install-sandbox.sh).  (If that fails, it's still
# imported.)
"$MOZSEARCH_PATH/scripts/analyze-spec-pr.sh" "$CONFIG_REPO/$TREE_NAME/specs.toml" "$NAME" "$OUT" ||
    echo "WARNING: Its semantic analysis failed."
rm -f "$OUT"

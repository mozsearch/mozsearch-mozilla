#!/usr/bin/env bash

set -x # Show commands
set -eu # Errors/undefined vars are fatal
set -o pipefail # Check all commands in a pipeline

# Generate firefox-disco's token-centric history ("hyperblame", bug 1517978)
# from scratch, and upload it if passed --upload; see update-history.sh, which
# this uses, for what the history is.  This is run on a fresh instance by
# mozsearch's infrastructure/aws/trigger_blame_rebuild.py (via rebuild-blame.sh
# and reblame-run.sh, which pass --upload), ex:
#
#   ./trigger_blame_rebuild.py https://github.com/mozsearch/mozsearch \
#     https://github.com/mozsearch/mozsearch-mozilla just-fd.json hyperblame \
#     dev-history --config-rev firefox-disco --instance-type m8id.16xlarge \
#     --setenv HISTORY_WINDOW_DAYS=14
#
# Options come from the environment (--setenv for the trigger script):
# - HISTORY_WINDOW_DAYS=N: Start the history at the last main revision from
#   more than N days ago, rather than at history/config.toml's start.
# - HISTORY_START=REV: Start the history at REV, or at the beginning of the
#   history if "none".
# - HISTORY_IN_PLACE=1: Upload the history as firefox-shared-history.tar.lz4,
#   which is the one the indexer updates, after copying any existing one to
#   backups/.  Otherwise it's uploaded as firefox-shared-history-new.tar.lz4.
#   (The indexer can only update a history whose start is history/config.toml's
#   start, since build-syntax-token-tree refuses to continue a history derived
#   with a different start.)
# - HISTORY_UPLOAD_NAME=NAME: Upload the history as NAME instead, ex: to keep
#   the histories of different runs apart.
# - COMMIT_LIMIT, as for update-history.sh.
#
# Progress is recorded in the instance's status tag, which mozsearch's
# infrastructure/aws/reblame-status.py shows.

UPLOAD=no
for ARG in "$@"; do
    case "$ARG" in
        --upload)
            UPLOAD=yes
            ;;
        *)
            echo "Unknown argument $ARG" > /dev/stderr
            exit 1
            ;;
    esac
done

status() {
    if [[ -n "${AWS_ROOT:-}" ]]; then
        $AWS_ROOT/set-status.py "$*"
    fi
}

if [[ -e "$HISTORY_ROOT" ]]; then
    echo "$HISTORY_ROOT already exists, but reblame generates the history from scratch." > /dev/stderr
    exit 1
fi

# ## The shared git repos
#
# Like ../firefox-shared/checkout-gecko-repos.sh, but we only need the new git
# repo, updated to the latest main, and the old git repo for the old revisions
# (which we don't bother updating, since only old revisions are in it).  (These
# are source repos, so this uses the system's `git`, which detects SHA-1
# collisions in what it fetches, rather than `mozsearch-git` as for the history
# below.)
status "downloading the shared firefox git repos"
mkdir -p $SHARED_ROOT
pushd $SHARED_ROOT
for REPO in git oldgit; do
    if [[ ! -d $REPO ]]; then
        aws s3 cp s3://searchfox.repositories/firefox-shared-$REPO.tar.lz4 . --no-sign-request
        lz4 -dc firefox-shared-$REPO.tar.lz4 | tar -x
        rm firefox-shared-$REPO.tar.lz4
        git -C ./$REPO worktree prune
    fi
done
popd

status "fetching the latest firefox main"
SHARED_BARE_GIT_ROOT=$SHARED_ROOT/git
git -C $SHARED_BARE_GIT_ROOT fetch
git -C $SHARED_BARE_GIT_ROOT update-ref refs/heads/main refs/remotes/origin/bookmarks/central

# ## The history configuration, with a different start if requested.
START=${HISTORY_START:-}
if [[ -n "${HISTORY_WINDOW_DAYS:-}" ]]; then
    START=$(git -C $SHARED_BARE_GIT_ROOT rev-list -1 --first-parent \
        --before="$HISTORY_WINDOW_DAYS days ago" refs/heads/main)
fi
export HISTORY_CONFIG=$CONFIG_REPO/firefox-disco/history
if [[ -n "$START" ]]; then
    mkdir -p $INDEX_ROOT
    HISTORY_CONFIG=$(mktemp -d "$INDEX_ROOT/history-config.XXXXXX")
    cp -r $CONFIG_REPO/firefox-disco/history/. "$HISTORY_CONFIG"
    grep -v '^start = ' $CONFIG_REPO/firefox-disco/history/config.toml > "$HISTORY_CONFIG/config.toml" || true
    if [[ "$START" != "none" ]]; then
        echo "start = \"$START\"" >> "$HISTORY_CONFIG/config.toml"
    fi
    cat "$HISTORY_CONFIG/config.toml"
fi

# ## The history
#
# update-history.sh downloads the uploaded history unless $HISTORY_ROOT exists.
mkdir -p "$HISTORY_ROOT"
status "generating the history (start ${START:-from history/config.toml})"
HISTORY_STATUS_COMMAND=${AWS_ROOT:+$AWS_ROOT/set-status.py} \
    $CONFIG_REPO/firefox-disco/update-history.sh "main"

if [[ "$UPLOAD" == "yes" ]]; then
    NAME=firefox-shared-history-new.tar.lz4
    if [[ "${HISTORY_IN_PLACE:-}" == "1" ]]; then
        NAME=firefox-shared-history.tar.lz4
    fi
    NAME=${HISTORY_UPLOAD_NAME:-$NAME}
    # Fully repacking the history makes it as small as possible to download.
    # It needs about as much space again as the repo being repacked, which
    # build-history.py leaves by fully repacking the repos as it goes when
    # they need it (see mozsearch's scripts/build-history.py).  This is the
    # repack git gc does (the rest of what it does doesn't matter for these
    # repos), plus --path-walk: most of the time goes to finding every object
    # reachable from every commit, which git's path walk did in half the time,
    # for a slightly smaller pack, on 4,000 recent revisions' timeline.  (As of
    # git 2.55, gc doesn't use the path walk even with pack.usePathWalk.)  With
    # mozsearch-git, the git the tools write the history with (see mozsearch's
    # nix/mozsearch/git.nix), as for build-history.py's repacks.
    status "repacking the history for $NAME"
    for repo in syntax timeline; do
        mozsearch-git -C "$HISTORY_ROOT/$repo" repack -d -l --cruft --cruft-expiration=2.weeks.ago --path-walk
    done
    if [[ "$NAME" == "firefox-shared-history.tar.lz4" ]]; then
        aws s3 cp "s3://searchfox.repositories/$NAME" "s3://searchfox.repositories/backups/$NAME" --acl public-read || true
    fi
    # Stream the archive to S3 rather than writing it next to the history, which
    # would need as much space again.  (aws needs to know about how big a stream
    # over 50 GB is to choose the size of its parts; lz4 barely shrinks packs.)
    pushd $SHARED_ROOT
    SIZE=$(du -sb "$(basename "$HISTORY_ROOT")" | cut -f1)
    status "uploading the history ($(numfmt --to=iec "$SIZE") before compression) as $NAME"
    tar cf - "$(basename "$HISTORY_ROOT")" | lz4 -c |
        aws s3 cp - "s3://searchfox.repositories/$NAME" --acl public-read --expected-size "$SIZE"
    popd
fi

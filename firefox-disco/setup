#!/usr/bin/env bash

set -x # Show commands
set -eu # Errors/undefined vars are fatal
set -o pipefail # Check all commands in a pipeline

# firefox-disco is a temporary tree, on its own server (config8.json), for
# developing the token-centric history ("hyperblame", bug 1517978).  It indexes
# the same revision as firefox-main (see ../firefox-main/setup for
# documentation), and it is the only tree which downloads, builds, updates, or
# uploads the history (firefox-shared-history.tar.lz4); see update-history.sh.

BUILD_REVISION_TREE=mozilla-central
BUILD_REVISION_ID=latest

# firefox-try's setup, in a setup group of its own (see config8.json), waits
# for this setup's signal that the firefox-shared repos are downloaded and
# updated, and that target.json has the revision (which it indexes too):
# "<SETUP_ID> ready" in REPOS_SIGNAL, or "<SETUP_ID> failed" if this setup ends
# before then (see mozsearch's infrastructure/indexer-setup.sh for SETUP_ID).
REPOS_SIGNAL="$SHARED_ROOT/firefox-disco-repos"
REPOS_SIGNALED=
signal_repos() {
    mkdir -p "$SHARED_ROOT"
    echo "${SETUP_ID:-none} $1" > "$REPOS_SIGNAL.tmp"
    mv "$REPOS_SIGNAL.tmp" "$REPOS_SIGNAL"
    REPOS_SIGNALED=1
}
trap '[[ -n $REPOS_SIGNALED ]] || signal_repos failed' EXIT

# The next line populates the INDEXED_HG_REV and PREEXISTING_HG_REV env vars.
source $CONFIG_REPO/firefox-shared/resolve-gecko-revs.sh $BUILD_REVISION_TREE $BUILD_REVISION_ID

# The history's download (download-history.sh) needs only the network and the
# disk, so it runs in the background while the git repos are downloaded and
# updated (profiling the 2026-10-27 config8 run, it took 3.9 minutes after
# their 5.5, all of the setup's critical path), its log shown once it's waited
# for.  update-history.sh then finds the history there.
mkdir -p "$SHARED_ROOT"
HISTORY_DOWNLOAD_LOG="$SHARED_ROOT/download-history.log"
$CONFIG_REPO/firefox-disco/download-history.sh > "$HISTORY_DOWNLOAD_LOG" 2>&1 &
HISTORY_DOWNLOAD_PID=$!

$CONFIG_REPO/firefox-shared/checkout-gecko-repos.sh $BUILD_REVISION_TREE "main" "$INDEXED_HG_REV"
signal_repos ready

$CONFIG_REPO/firefox-shared/fetch-tc-artifacts.sh $BUILD_REVISION_TREE $INDEXED_HG_REV "$PREEXISTING_HG_REV"

echo "Waiting for setup::download-history for $TREE_NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"
if ! wait $HISTORY_DOWNLOAD_PID; then
    cat "$HISTORY_DOWNLOAD_LOG"
    echo "Downloading the history failed"
    exit 1
fi
cat "$HISTORY_DOWNLOAD_LOG"
rm -f "$HISTORY_DOWNLOAD_LOG"

$CONFIG_REPO/firefox-disco/update-history.sh "main"

# (And MDN's browser-compat-data, for spec-analyze; see
# ../shared/fetch-bcd.sh.)
$CONFIG_REPO/shared/fetch-bcd.sh

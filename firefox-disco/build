#!/usr/bin/env bash

set -x # Show commands
set -eu # Errors/undefined vars are fatal
set -o pipefail # Check all commands in a pipeline

# (Like firefox-main's; see there.)  scip-typescript needs only the checkout,
# so it runs in the background while the Gecko analysis is processed (it took
# 2.6 minutes on one core after it, which firefox-disco's indexing waited
# for), its log shown once it's done.
SCIP_TS_LOG="$INDEX_ROOT/scip-typescript.log"
(
    set -eu
    set -o pipefail
    echo "Performing build::scip-typescript step for $TREE_NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"
    cd "$GIT_ROOT"
    npm install
    # (As try pushes' analysis lists and indexes them, with mozsearch's
    # scip-typescript-index.sh, if it has it; see firefox-try's build.)
    "$CONFIG_REPO/firefox-shared/typescript-projects.sh" . > "$INDEX_ROOT/typescript-projects"
    if [ -x "$MOZSEARCH_PATH/scripts/scip-typescript-index.sh" ]; then
        "$MOZSEARCH_PATH/scripts/scip-typescript-index.sh" . "$INDEX_ROOT/typescript-projects" \
            "$INDEX_ROOT/typescript.scip"
    else
        scip-typescript index --max-file-byte-size 0 $(cat "$INDEX_ROOT/typescript-projects")
        mv index.scip "$INDEX_ROOT/typescript.scip"
    fi
    rm -rf node_modules
    echo "build::scip-typescript done for $TREE_NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"
) > "$SCIP_TS_LOG" 2>&1 &
SCIP_TS_PID=$!

# scip-python, in the background too (see ../firefox-shared/scip-python.sh,
# which firefox-try's build runs too), its log shown once it's done.
SCIP_PY_LOG="$INDEX_ROOT/scip-python.log"
"$CONFIG_REPO/firefox-shared/scip-python.sh" > "$SCIP_PY_LOG" 2>&1 &
SCIP_PY_PID=$!

pushd $INDEX_ROOT
$CONFIG_REPO/firefox-shared/process-gecko-analysis.sh
popd

echo "Waiting for build::scip-typescript for $TREE_NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"
if ! wait $SCIP_TS_PID; then
    cat "$SCIP_TS_LOG"
    echo "scip-typescript failed"
    exit 1
fi
cat "$SCIP_TS_LOG"
rm -f "$SCIP_TS_LOG"

echo "Waiting for build::scip-python for $TREE_NAME : $(date +"%Y-%m-%dT%H:%M:%S%z")"
if ! wait $SCIP_PY_PID; then
    cat "$SCIP_PY_LOG"
    echo "scip-python failed"
    exit 1
fi
cat "$SCIP_PY_LOG"
rm -f "$SCIP_PY_LOG"
